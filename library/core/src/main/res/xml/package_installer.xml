<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:myLocation="@string/package_installer"
    app:quick_restart="com.miui.packageinstaller">
    <PreferenceCategory>

        <!-- 安装过程里所有会打断、劝退的环节合成这一个开关；
             细分项（推广 / 风险检测 / 云端配置 / ICP 备案 / 安全守护 / 频繁安装检查 /
             自动确认弹窗 / 取消后退出 / 系统应用安装限制 / 上传应用信息）见
             PackageInstaller#onPackageLoaded 里的注释 -->
        <SwitchPreference
            android:key="prefs_key_miui_package_installer_purify_install"
            android:title="@string/miui_package_installer_purify_install"
            android:summary="@string/miui_package_installer_purify_install_desc"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="prefs_key_miui_package_installer_apk_info"
            android:title="@string/miui_package_installer_apk_info"
            android:summary="@string/miui_package_installer_apk_info_desc"
            android:defaultValue="false" />

        <EditTextPreference
            android:title="@string/miui_package_installer_install_source"
            android:key="prefs_key_miui_package_installer_install_source"
            android:defaultValue="com.android.fileexplorer" />

    </PreferenceCategory>

</PreferenceScreen>
